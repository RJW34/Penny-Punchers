{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical scaffold preparation shape",
  "$comment": "Preserved original scaffold shape, not the runtime wire model. Active PreparationPlan uses up to6 mixed ItemIds, zero legacy ReserveFloor, ContentHash and optional QuotedCost; see Core/SimulationState.cs, PreparationRules.cs and App/PrivateMatchPeer.cs. No client-supplied credit balance is accepted.",
  "type": "object",
  "properties": {
    "round_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "seat_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "plan_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "lease_ids": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reserve_floor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600
    },
    "locked": {
      "type": "boolean"
    }
  },
  "required": [
    "round_id",
    "seat_id",
    "plan_version",
    "lease_ids",
    "reserve_floor",
    "locked"
  ],
  "additionalProperties": false
}
