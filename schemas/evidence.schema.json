{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Game evidence ledger, not scaffold report",
  "type": "object",
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "requirement_id",
          "status",
          "build_ref",
          "content_sha256",
          "timestamp_utc",
          "platform",
          "command",
          "exit_code",
          "artifacts"
        ],
        "properties": {
          "requirement_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "build_ref": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "timestamp_utc": {
            "type": "string",
            "format": "date-time"
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "path",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "test_log",
                    "build_log",
                    "process_log",
                    "video",
                    "screenshot",
                    "replay",
                    "metrics",
                    "binary",
                    "human_feedback"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "reviewer": {
            "type": "string"
          },
          "limitations": {
            "type": "string"
          }
        }
      }
    }
  }
}
