{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Round rentals, repeatable EX licenses and one-use super permits",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "enum": [
              "signature",
              "technique",
              "gambit",
              "ex",
              "super"
            ]
          },
          "price": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2400
          },
          "eligible_fighters": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "move_id": {
            "type": "string",
            "minLength": 1
          },
          "replaces": {
            "type": [
              "string",
              "null"
            ]
          },
          "duration": {
            "const": "one_round"
          },
          "commit_frame": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "refund_after_lock": {
            "const": false
          },
          "alters_system_defense": {
            "const": false
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "tradeoff": {
            "type": "string",
            "minLength": 1
          },
          "activation_credit_cost": {
            "const": 0
          },
          "use_limit": {
            "enum": [
              null,
              1
            ]
          },
          "debit": {
            "const": "preparation_commit"
          },
          "catalog_id": {
            "type": "string",
            "maxLength": 64
          },
          "legacy_item_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "access_policy": {
            "enum": [
              "round_license",
              "prepaid_super"
            ]
          },
          "implementation_status": {
            "const": "implemented"
          },
          "conflicts_with": {
            "type": "array",
            "maxItems": 255,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "required": [
          "id",
          "name",
          "slot",
          "price",
          "eligible_fighters",
          "move_id",
          "replaces",
          "duration",
          "commit_frame",
          "refund_after_lock",
          "alters_system_defense",
          "description",
          "tradeoff",
          "activation_credit_cost",
          "use_limit",
          "debit",
          "access_policy",
          "implementation_status",
          "conflicts_with"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "slot": {
                  "const": "super"
                }
              }
            },
            "then": {
              "properties": {
                "use_limit": {
                  "const": 1
                },
                "access_policy": {
                  "const": "prepaid_super"
                }
              }
            },
            "else": {
              "properties": {
                "use_limit": {
                  "type": "null"
                },
                "access_policy": {
                  "const": "round_license"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "items"
  ],
  "additionalProperties": false
}
