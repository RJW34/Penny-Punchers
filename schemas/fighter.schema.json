{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Original 2D fighter timelines",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "archetype": {
      "type": "string",
      "minLength": 1
    },
    "health": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "stun_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "physics": {
      "type": "object"
    },
    "pushbox": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "hurtboxes": {
      "type": "object",
      "properties": {
        "standing": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "crouching": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "air": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "y": {
                "type": "integer",
                "minimum": -1000000,
                "maximum": 1000000
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "standing",
        "crouching",
        "air"
      ],
      "additionalProperties": false
    },
    "super_arts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "move_id": {
            "type": "string",
            "minLength": 1
          },
          "credit_cost": {
            "const": 0
          },
          "selected_at": {
            "const": "preparation_commit"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "move_id",
          "credit_cost",
          "selected_at",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "default_super": {
      "type": "string",
      "minLength": 1
    },
    "target_combos": {
      "type": "array"
    },
    "moves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "normal",
              "unique",
              "throw",
              "special",
              "ex_special",
              "super",
              "gambit"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "startup": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "active": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "recovery": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "credit_cost": {
            "const": 0
          },
          "debit_on_start": {
            "const": false
          },
          "negative_edge": {
            "type": "boolean"
          },
          "availability": {
            "type": "string",
            "minLength": 1
          },
          "pose": {
            "type": "string",
            "minLength": 1
          },
          "hitboxes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "y": {
                  "type": "integer",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "end": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "level": {
                  "enum": [
                    "mid",
                    "low",
                    "overhead",
                    "air"
                  ]
                },
                "damage": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "stun": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "rank": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "hitstun": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "blockstun": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "push_x": {
                  "type": "integer",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "launch_y": {
                  "type": "integer",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "knockdown": {
                  "enum": [
                    "none",
                    "soft",
                    "hard"
                  ]
                },
                "hit_group": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "juggle_cost": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483647
                },
                "parryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height",
                "id",
                "start",
                "end",
                "level",
                "damage",
                "stun",
                "rank",
                "hitstun",
                "blockstun",
                "push_x",
                "launch_y",
                "knockdown",
                "hit_group",
                "juggle_cost",
                "parryable"
              ],
              "additionalProperties": false
            }
          },
          "events": {
            "type": "array"
          },
          "cancel_rules": {
            "type": "array"
          },
          "invulnerability": {
            "type": "array"
          },
          "movement": {
            "type": "array"
          },
          "projectile": {
            "type": [
              "object",
              "null"
            ]
          },
          "hurtbox_windows": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "replace_body": {
                  "type": "boolean"
                },
                "boxes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": -1000000,
                        "maximum": 1000000
                      },
                      "y": {
                        "type": "integer",
                        "minimum": -1000000,
                        "maximum": 1000000
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  }
                },
                "intent": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "start",
                "end",
                "replace_body",
                "boxes",
                "intent"
              ],
              "additionalProperties": false
            }
          },
          "access_policy": {
            "enum": [
              "base",
              "round_license",
              "prepaid_super"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "command",
          "startup",
          "active",
          "recovery",
          "credit_cost",
          "debit_on_start",
          "negative_edge",
          "availability",
          "pose",
          "hitboxes",
          "events",
          "cancel_rules",
          "invulnerability",
          "movement",
          "projectile",
          "access_policy"
        ],
        "additionalProperties": true
      },
      "maxItems": 256
    },
    "resource_notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "id",
    "display_name",
    "archetype",
    "health",
    "stun_limit",
    "physics",
    "pushbox",
    "hurtboxes",
    "super_arts",
    "default_super",
    "target_combos",
    "moves",
    "resource_notes"
  ],
  "additionalProperties": false
}
