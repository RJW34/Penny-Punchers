{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ruleset_id",
    "catalog_sha256",
    "session_id",
    "round",
    "seat",
    "product_ids"
  ],
  "properties": {
    "ruleset_id": {
      "const": "pp-shop-only-v2-candidate"
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "seat": {
      "enum": [
        0,
        1
      ]
    },
    "product_ids": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    }
  }
}
